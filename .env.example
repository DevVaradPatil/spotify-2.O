# Copy this file to .env.local and fill in real values.
#
# Do NOT commit .env or .env.local — both are gitignored.
# In production these are set in the Vercel project's Environment Variables,
# never in a file.

# --- Supabase -----------------------------------------------------------
# Dashboard -> Project Settings -> API
# The URL and anon key are shipped to the browser and are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security entirely — full read/write on the
# database. Never prefix with NEXT_PUBLIC_ and never reference it from a
# client component. Used by libs/supabaseAdmin.ts and server.js only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -------------------------------------------------------------
# Dashboard -> Developers -> API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SERVER ONLY.
STRIPE_SECRET_KEY=

# Dashboard -> Developers -> Webhooks -> signing secret.
# STRIPE_WEBHOOK_SECRET_LIVE takes precedence when set (see app/api/webhooks/route.ts).
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_LIVE=

# --- Application --------------------------------------------------------
# Public origin, used to build Stripe checkout redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set automatically by Vercel; used as a fallback by libs/helpers.ts#getURL().
NEXT_PUBLIC_VERCEL_URL=

# --- Music room WebSocket ------------------------------------------------
# Origin of the ws server (server.js). No trailing slash, no path — the room
# code is appended by hooks/useRoomSocket.ts.
# Local:      ws://localhost:8080
# Deployed:   wss://your-ws-host.example.com
NEXT_PUBLIC_WS_URL=ws://localhost:8080
